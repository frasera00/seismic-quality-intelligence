# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment files and secrets
.env
.env.*
!.env.example

# Large datasets: retain only .gitkeep markers
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep

# Generated ML outputs
models/
artifacts/
mlruns/
wandb/
